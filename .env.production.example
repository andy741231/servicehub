# Production environment - set these as Azure App Service Application Settings
# Connects to: production-servicehub (Azure SQL)
DATABASE_URL="sqlserver://houstonservice-test.database.windows.net:1433;database=production-servicehub;user=<db_user>;password=<db_password>;encrypt=true;trustServerCertificate=false;connectionTimeout=30"

NODE_ENV=production
JWT_SECRET=<strong_random_secret>
JWT_REFRESH_SECRET=<strong_random_secret>
PORT=4000
CLIENT_URL=https://<your-app>.azurewebsites.net

# Email — Azure Communication Services (App 3)
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_EMAIL=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=uploads

# Inbound email webhook — shared secret for Google Apps Script
INBOUND_EMAIL_WEBHOOK_SECRET=<strong_random_secret>
