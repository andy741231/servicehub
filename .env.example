# Copy this file to .env and fill in values for local development.
# Ask a team member for the actual credentials.
#
# Database: local SQL Server in Docker (docker compose up -d; the password below
# feeds the container's sa login). Pull a full copy of the shared stage DB with:
#   npm run db:pull
DATABASE_URL="sqlserver://localhost:1433;database=servicehub_dev;user=sa;password=<MSSQL_SA_PASSWORD>;encrypt=true;trustServerCertificate=true"

# SA password for the Docker SQL Server container (docker-compose.yml reads this)
MSSQL_SA_PASSWORD=

# Source for `npm run db:pull` — the shared Azure "stage" database (ask a teammate)
DATABASE_URL_STAGE="sqlserver://houstonservice-test.database.windows.net:1433;database=stage;user=servicehub_dev;password=<ask_team>;encrypt=true;trustServerCertificate=false;connectionTimeout=30"

# Production database — only needed for running db push/seed against prod (admins only)
DATABASE_URL_PROD="sqlserver://houstonservice-test.database.windows.net:1433;database=production-servicehub;user=servicehub_prod;password=<ask_team>;encrypt=true;trustServerCertificate=false;connectionTimeout=30"

# JWT secrets — use long random strings in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Frontend dev server URL (for CORS in local dev)
CLIENT_URL=http://localhost:3000

# Email — Azure Communication Services (App 3)
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_EMAIL=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=uploads

# Inbound email webhook — shared secret for Google Apps Script
INBOUND_EMAIL_WEBHOOK_SECRET=change-me-to-a-random-string
