// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Core (shared across all apps)
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  username     String?  @unique
  email        String
  password     String
  name         String
  isActive     Boolean  @default(true)
  refreshToken String?
  preferences  String?  @db.NVarChar(Max) // JSON: { theme: 'dark' | 'light', ... }
  createdAt    DateTime @default(now())
  roles        UserRole[]
  permissions  AppPermission[]
  directoryMembers DirectoryMember[]
}

model Role {
  id    String     @id @default(uuid())
  name  String     @unique   // "super_admin" | "admin" | "editor" | "viewer"
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model AppPermission {
  id        String  @id @default(uuid())
  userId    String
  appId     String  // matches APPS[].id
  canAccess Boolean @default(false)
  user      User @relation(fields: [userId], references: [id])
  @@unique([userId, appId])
}

// ----------------------------------------------------------------------------
// App 1 — Web Builder
// ----------------------------------------------------------------------------

model WebPage {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  template    String     @default("modern")
  header      String?    // JSON serialized — parsed/serialized in controller
  footer      String?    // JSON serialized — parsed/serialized in controller
  isPublished Boolean    @default(true)
  publishedSnapshot String? @db.NVarChar(Max) // JSON snapshot of published content (header, footer, sections+blocks). Null = use live sections/blocks as published (backward compat).
  navLabel    String?
  href        String?    // for external link nav items
  parentId    String?    // self-referencing for sub-menu items
  order       Int        @default(0) // for drag-and-drop reordering
  isReserved  Boolean    @default(false) // reserved for system use
  hideFromNav Boolean    @default(false) // hide from main navigation
  blocks      WebBlock[]
  sections    WebSection[]
  versions    WebPageVersion[]
  updatedAt   DateTime   @updatedAt
}

model WebPageTemplate {
  id          String   @id @default(uuid())
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(1000)
  snapshot    String   @db.NVarChar(Max) // JSON page-content snapshot, isolated to the Web Builder
  createdById String
  createdByName String @db.NVarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebPageVersion {
  id            String   @id @default(uuid())
  pageId        String
  title         String   @db.NVarChar(255)
  snapshot      String   @db.NVarChar(Max) // JSON page-content snapshot at save time
  savedById     String
  savedByName   String   @db.NVarChar(255)
  versionNumber Int
  createdAt     DateTime @default(now())
  page          WebPage  @relation(fields: [pageId], references: [id])
}

model WebSection {
  id             String     @id @default(uuid())
  pageId         String
  order          Int
  columns        Int        @default(1)   // legacy: 1 = full-width, 2-6 = multi-column
  gap            Int        @default(24)  // legacy: px gap between columns
  fluidConfig    String?    @db.NVarChar(Max) // JSON string — Fluid Engine settings: { gridColumns, gap:{horizontal,vertical}, fillScreen, minHeight, verticalAlignment }
  paddingTop     Int        @default(48)
  paddingBottom  Int        @default(48)
  paddingLeft    Int        @default(0)
  paddingRight   Int        @default(0)
  marginTop      Int        @default(0)
  marginBottom   Int        @default(0)
  backgroundColor String?               // optional hex / CSS colour
  page           WebPage    @relation(fields: [pageId], references: [id])
  blocks         WebBlock[]
}

model WebBlock {
  id        String      @id @default(uuid())
  pageId    String
  sectionId String?
  type      String      // "hero" | "text" | "image" | "features" | ...
  order     Int
  content   String      // JSON serialized — parsed/serialized in controller
  page      WebPage     @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section   WebSection? @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ----------------------------------------------------------------------------
// App 2 — Form Builder
// ----------------------------------------------------------------------------

model Form {
  id          String           @id @default(uuid())
  title       String           @db.NVarChar(255)
  schema      String           @db.NVarChar(Max) // JSON serialized — parsed/serialized in controller
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?        // Soft delete support
  submissions FormSubmission[]
  versions    FormVersion[]
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String
  data      String   @db.NVarChar(Max) // JSON serialized — parsed/serialized in controller
  createdAt DateTime @default(now())
  form      Form @relation(fields: [formId], references: [id])
}

model FormVersion {
  id        String   @id @default(uuid())
  formId    String
  title     String   @db.NVarChar(255)
  schema    String   @db.NVarChar(Max) // JSON snapshot of the form schema at save time
  savedById String   // User who saved this version
  savedByName String @db.NVarChar(255) // Display name cached at save time
  versionNumber Int  // Sequential version counter per form
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id])
}

model FormFolder {
  id        String   @id @default(uuid())
  name      String   @db.NVarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// App 3 — Email Sender
// ----------------------------------------------------------------------------

model EmailCampaign {
  id             String             @id @default(uuid())
  name           String
  subject        String
  bodyHtml       String
  status         String             // "draft" | "scheduled" | "sent" | "paused"
  scheduledAt    DateTime?
  sentAt         DateTime?
  mailingListId  String?
  mailingList    MailingList?       @relation(fields: [mailingListId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?          // Soft delete support
  logs           EmailLog[]
  metrics        CampaignMetrics?
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String   @default("")
  document  String   @db.NVarChar(Max)
  bodyHtml  String   @db.NVarChar(Max)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MailingList {
  id          String      @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  recipients  Recipient[]
  campaigns   EmailCampaign[]
}

model Recipient {
  id            String      @id @default(uuid())
  email         String
  firstName     String?
  lastName      String?
  customFields  String?     // JSON serialized for custom contact fields
  status        String      @default("active") // "active" | "unsubscribed" | "bounced" | "complained"
  mailingListId String
  list          MailingList @relation(fields: [mailingListId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model EmailLog {
  id         String        @id @default(uuid())
  campaignId String
  recipient  String
  status     String        // "sent" | "delivered" | "opened" | "clicked" | "bounced" | "complained" | "unsubscribed"
  sentAt     DateTime      @default(now())
  metadata   String?       // JSON serialized for additional event data
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id])
}

model CampaignMetrics {
  id          String        @id @default(uuid())
  campaignId  String        @unique
  sent        Int           @default(0)
  delivered   Int           @default(0)
  opened      Int           @default(0)
  clicked     Int           @default(0)
  bounced     Int           @default(0)
  unsubscribed Int          @default(0)
  complained  Int           @default(0)
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id])
}

model InboundEmail {
  id         String   @id @default(uuid())
  messageId  String?  // RFC 822 Message-ID header
  fromEmail  String
  fromName   String?
  toEmail    String
  subject    String
  bodyText   String?  @db.NVarChar(Max)
  bodyHtml   String?  @db.NVarChar(Max)
  labels     String?  // JSON array of labels/tags
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([receivedAt])
  @@index([fromEmail])
}

// ----------------------------------------------------------------------------
// App 1 — Web Builder (extended)
// ----------------------------------------------------------------------------

model WebSiteStyle {
  id             String   @id @default(uuid())
  tokens         String   // JSON: { colors: { primary, secondary, accent, background, text }, fonts: { heading, body }, spacing: { base } }
  draftTemplates String?  // JSON: { homeDraft: {...}, pageDraft: {...} }
  updatedAt      DateTime @updatedAt
}

model WebAsset {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String   // relative path like /uploads/filename
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// App 4 — Directory (church phone list)
// ----------------------------------------------------------------------------

// NB: userId + spouseMemberId uniqueness is enforced by filtered unique indexes
// (WHERE col IS NOT NULL) created in the 20260915_add_directory_tables migration.
// Prisma @unique can't express filtered indexes on SQL Server — an unfiltered
// unique index would allow only ONE null, breaking members without logins/spouses.

model DirectoryMember {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  // Identity
  email             String?
  firstName         String
  middleName        String?
  lastName          String
  otherName         String?                // other spelling, maiden name, non-English script
  gender            String?                // "brother" | "sister"
  maritalStatus     String?                // "single" | "married" | "widowed" | "divorced"
  dateOfBirth       DateTime?
  photoUrl          String?

  // Household / couple
  isHeadOfHousehold Boolean  @default(false)
  spouseMemberId    String?
  spouse            DirectoryMember?  @relation("Spouses", fields: [spouseMemberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  spouseOf          DirectoryMember[] @relation("Spouses")
  spouseFirstName   String?                // free-text for a spouse not in the list
  spouseLastName    String?
  coupleId          String?                // system-generated, shared by both spouses

  // Directory metadata
  role              String   @default("saint")    // "saint" | "helper" | "approver" | "admin"
  status            String   @default("pending")  // "pending" | "active" | "inactive" | "moved" | "deceased" | "negative" | "duplicate" | "delete"
  district          String
  smallGroup        String?
  locality          String   @default("Houston")
  optedIn           Boolean  @default(true)
  addedAt           DateTime @default(now())

  // Import provenance — where the record came from and whether anyone has
  // verified it since. Legacy phone-list rows are reviewed over time.
  source           String?   // e.g. "pdf-2024" | "manual" | null
  sourceAsOf       DateTime? // date the source data was current (list year)
  importBatchId    String?   // groups rows from one import run
  lastVerifiedAt   DateTime? // staff confirmed the record is accurate

  // Contact
  phone1            String?
  phone2            String?
  phonePrivacy      Boolean  @default(true)   // true = visible to other saints
  address           String?
  apartment         String?
  city              String?
  state             String?
  zip               String?
  addressPrivacy    Boolean  @default(false)  // false = hidden from other saints

  // Audit (last-change fields)
  changeType        String?
  changedAt         DateTime?
  changedByName     String?
  account           DirectoryAccount?
  auditLogs         DirectoryAuditLog[]
  loginTokens       DirectoryLoginToken[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([district])
  @@index([status])
  @@index([lastName])
}

model DirectoryAuditLog {
  id         String          @id @default(uuid())
  memberId   String
  actorId    String
  actorName  String
  changeType String          // "created" | "updated" | "activated" | "status_changed" | "role_changed" | "district_changed" | "deleted"
  summary    String?         @db.NVarChar(Max)
  createdAt  DateTime        @default(now())
  member     DirectoryMember @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([memberId])
}

// Saint-facing sign-in — intentionally separate from the Hub User table so
// directory sessions can never become Hub sessions. Email is the login
// identifier and must be unique across accounts; members without email simply
// cannot sign in (helpers manage them).
model DirectoryAccount {
  id             String   @id @default(uuid())
  memberId       String   @unique
  member         DirectoryMember @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  email          String   @unique                // normalized (lowercase) login email
  passwordHash   String?                          // null = magic-link only
  sessionVersion Int      @default(1)             // bump revokes every issued session
  passwordSetAt  DateTime?
  lastLoginAt    DateTime?
  disabledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One-time magic-link sign-in tokens for saints (no password needed).
// The raw token travels in the emailed link; only its SHA-256 hash is stored.
model DirectoryLoginToken {
  id        String          @id @default(uuid())
  memberId  String
  tokenHash String          @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  member    DirectoryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}
